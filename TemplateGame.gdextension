[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64 = "res://rust/target/debug/libtemplate_game.so"
linux.release.x86_64 = "res://rust/target/release/libtemplate_game.so"
windows.debug.x86_64 = "res://rust/target/debug/template_game.dll"
windows.release.x86_64 = "res://rust/target/release/template_game.dll"
macos.debug = "res://rust/target/debug/libtemplate_game.dylib"
macos.release = "res://rust/target/release/libtemplate_game.dylib"
